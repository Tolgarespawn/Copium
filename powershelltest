Add-Type -AssemblyName System.Windows.Forms

# Form
$form = New-Object System.Windows.Forms.Form
$form.Text = "Kullanıcı Silici"
$form.Size = New-Object System.Drawing.Size(400,500)

# ListView (Checkbox'lı)
$listView = New-Object System.Windows.Forms.ListView
$listView.View = 'Details'
$listView.CheckBoxes = $true
$listView.FullRowSelect = $true
$listView.Size = New-Object System.Drawing.Size(360,350)
$listView.Location = New-Object System.Drawing.Point(10,10)
$listView.Columns.Add("Kullanıcı Adı", 340)

# Kullanıcıları çek
$users = Get-LocalUser

foreach ($user in $users) {
    $item = New-Object System.Windows.Forms.ListViewItem($user.Name)
    $listView.Items.Add($item)
}

# Tümünü Seç Butonu
$selectAllButton = New-Object System.Windows.Forms.Button
$selectAllButton.Text = "Tümünü Seç"
$selectAllButton.Size = New-Object System.Drawing.Size(100,30)
$selectAllButton.Location = New-Object System.Drawing.Point(10,370)
$selectAllButton.Add_Click({
    foreach ($item in $listView.Items) {
        $item.Checked = $true
    }
})

# Seçili Olanları Sil Butonu
$deleteButton = New-Object System.Windows.Forms.Button
$deleteButton.Text = "Seçili Olanları Sil"
$deleteButton.Size = New-Object System.Drawing.Size(120,30)
$deleteButton.Location = New-Object System.Drawing.Point(120,370)
$deleteButton.Add_Click({
    foreach ($item in $listView.CheckedItems) {
        $username = $item.Text
        try {
            Remove-LocalUser -Name $username -ErrorAction Stop
        } catch {
            [System.Windows.Forms.MessageBox]::Show("Kullanıcı silinemedi: $username")
        }
    }
    [System.Windows.Forms.MessageBox]::Show("Seçili kullanıcılar silindi.")
    $form.Close()
})

$form.Controls.Add($listView)
$form.Controls.Add($selectAllButton)
$form.Controls.Add($deleteButton)

# Formu göster
$form.Topmost = $true
$form.Add_Shown({$form.Activate()})
[void]$form.ShowDialog()
